// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Represents the restaurant's general identity/settings
model RestaurantProfile {
  id      Int     @id @default(1)
  name    String  @default("My Restaurant")
  logoUrl String?
  theme   String?
}

/// Represents an item on the restaurant menu.
model MenuItem {
  id          Int     @id @default(autoincrement())
  title       String  @unique
  price       Float
  image       String?
  description String?
  category    String?
  isAvailable Boolean @default(true)

  orderItems OrderItem[] // Relation to items in an order
}

/// Represents a table in the restaurant.
model Table {
  id          Int    @id @default(autoincrement())
  tableNumber String @unique // e.g., "T1"
  capacity    Int    @default(4) // How many people this table can seat

  orders Order[] // Relation to orders placed at this table
}

/// Represents a customer's order.
model Order {
  id     Int         @id @default(autoincrement())
  status String      @default("NEW") // "NEW", "PROCESSING", "READY", "SERVED", "PAID", "CANCELLED"
  total  Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableId Int
  table   Table @relation(fields: [tableId], references: [id])

  customerName String?
  numberOfGuests Int @default(1)

  items OrderItem[] // List of items in this order

  @@index([status]) // Index to speed up filtering by status
}

///  join table between Order and MenuItem.
model OrderItem {
  id       Int @id @default(autoincrement())
  quantity Int
  price    Float // Price of the menu item at the time of order

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

/// User acounts table
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   // "ADMIN", "WAITER", "KITCHENSTAFF"
  isActive  Boolean  @default(true)
}
