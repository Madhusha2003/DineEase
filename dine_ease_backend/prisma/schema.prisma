// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Represents an item on the restaurant menu.
model MenuItem {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  price       Float
  image       String?
  description String?
  category    String?
  isAvailable Boolean  @default(true)

  orderItems OrderItem[] // Relation to items in an order

}

/// Represents a table in the restaurant.
model Table {
  id          Int     @id @default(autoincrement())
  tableNumber String  @unique // e.g., "T1"
  
  orders      Order[] // Relation to orders placed at this table
}

/// Represents a customer's order.
model Order {
  id        Int         @id @default(autoincrement())
  status    OrderStatus @default(NEW)
  total     Float       // The total price of the order, from waiterOrders.js

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tableId   Int
  table     Table       @relation(fields: [tableId], references: [id])

  items     OrderItem[] // List of items in this order
}

///  join table between Order and MenuItem.
model OrderItem {
  id         Int     @id @default(autoincrement())
  quantity   Int     
  size       String? // e.g., "Regular", "Medium", "Large"
  note       String? // e.g., "Extra spicy", "No onions"

  orderId    Int
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

///  statuses for an order.
enum OrderStatus {
  NEW        // "new" or "Pending"
  PROCESSING // "process" or "In Preparation"
  READY
  SERVED
  CANCELLED
}